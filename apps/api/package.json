{
  "name": "@watchtower/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "create-user": "tsx --env-file=.env src/scripts/create-user.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@watchtower/database": "workspace:*",
    "@watchtower/shared": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.6.0",
    "ssh2": "^1.16.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ssh2": "^1.15.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.8"
  }
}
