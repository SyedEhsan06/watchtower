# PostgreSQL connection string used by Prisma (packages/database) and the API.
DATABASE_URL="postgresql://watchtower:watchtower@localhost:5433/watchtower"

# Public URL of the Next.js app. Used by the API for CORS.
APP_URL="http://localhost:3000"

# Public URL of the Fastify API. Used by the Next.js app (server + browser).
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Secret used to sign/validate auth-related tokens. Generate with:
#   openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-64-char-hex-string"

# AES-256-GCM master key for encrypting SSH private keys at rest. MUST be a
# 32-byte key encoded as hex (64 hex chars) or base64. Generate with:
#   openssl rand -hex 32
# The API will refuse to start without a valid key.
SSH_MASTER_ENCRYPTION_KEY="replace-with-openssl-rand--hex-32-output"

# Web Push (VAPID) keys for browser push notifications. Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Same public key, exposed to the browser bundle so it can create a push subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Fastify log level: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# Keep background monitoring jobs off when local development points at the
# shared Supabase database. Enable only for an isolated development database.
ENABLE_BACKGROUND_JOBS="false"

# Port the Fastify API listens on.
PORT=4000
