# Used by docker-compose.yml. Run ./scripts/gen-env.sh to create .env from this
# template with random secrets, or copy it and fill the values in by hand.

# Postgres password. Keep it URL-safe (hex is ideal): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=

# Signs/keys API-key hashes (HMAC-SHA256). `openssl rand -hex 32`
AUTH_SECRET=

# AES-256-GCM master key that encrypts stored SSH private keys. 32 bytes, hex or
# base64: `openssl rand -hex 32`. BACK THIS UP outside the database; losing it
# makes every stored SSH key unrecoverable. The API refuses to start without it.
SSH_MASTER_ENCRYPTION_KEY=

# Optional: Web Push (browser notifications). `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# URL the web app is served from (used for the API's CORS allowlist).
APP_URL=http://localhost:3000
# URL the browser uses to reach the API. Baked into the web image at build time:
# rebuild (`docker compose up -d --build`) after changing it.
PUBLIC_API_URL=http://localhost:4000

# Cookies. Plain HTTP (localhost) needs COOKIE_SECURE=false. Behind HTTPS set it
# to true. If web and API are on sibling subdomains, set COOKIE_DOMAIN=.example.com
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Interface the published ports bind to. 127.0.0.1 = this machine only.
# Put a TLS reverse proxy (Caddy/nginx) in front before exposing publicly.
BIND_ADDRESS=127.0.0.1
